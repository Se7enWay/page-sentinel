<![CDATA[# ──────────────────────────────────────────────────────────────
# .env.example — Configuration Template
# ──────────────────────────────────────────────────────────────
# Copy this file to .env and fill in your values:
#     cp .env.example .env
#
# IMPORTANT: Never commit your .env file to Git!
#            It contains your private webhook URLs and topic names.
# ──────────────────────────────────────────────────────────────

# ── Target URL ──
# The web page to monitor for changes
TARGET_URL=http://fsr.ac.ma/DOC/Preselections/Cycle_Masters/LISTES_CONCOURS_ECRIT/

# ── Check Interval ──
# How often to check the page (in seconds)
# 30 seconds is a good balance between speed and not overloading the server
CHECK_INTERVAL=30

# ── ntfy Configuration ──
# Get the ntfy app: https://ntfy.sh
# Pick a unique, hard-to-guess topic name (it acts as your password)
NTFY_ENABLED=true
NTFY_TOPIC=your-unique-topic-name-here
NTFY_SERVER=https://ntfy.sh

# ── Discord Configuration ──
# Create a webhook: Server Settings → Integrations → Webhooks → New Webhook
DISCORD_ENABLED=true
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/YOUR_ID/YOUR_TOKEN

# ── Monitoring Behavior ──
# CSS selector for finding links on the page
LINK_SELECTOR=a[href]

# Only watch files with these extensions (comma-separated, e.g., .pdf,.docx)
# Leave empty to watch ALL links
FILE_EXTENSIONS=.pdf

# ── State File ──
# Where to save the list of known files (relative to project root)
STATE_FILE=state.json
]]>
